# Szablon konfiguracji dla `make hybryda`. Ten plik JEST w repozytorium,
# bo nie zawiera sekretu - tylko referencje do 1Password.
#
# Uruchomienie bez kopiowania klucza na dysk:
#
#   op run --env-file=.env.op -- make hybryda MODUL=invoice
#
# Albo lokalnie: skopiuj do .env (jest w .gitignore) i wstaw wartosci.
# .env nigdy nie trafia do gita i nigdy nie jest wypisywany na ekran.

# Klucz do API zgodnego z OpenAI. Pynguin czyta go ze SRODOWISKA
# (pynguin/utils/openai_key_resolver.py: PYNGUIN_OPENAI_API_KEY,
# OPENAI_API_KEY, LLM_API_KEY) - nigdy nie podajemy go przez --api_key,
# bo flagi widac w `ps` i w historii powloki.
OPENAI_API_KEY="op://Private/OpenAI/api_key"

# Model. UWAGA: sama zmienna nie wystarczy - patrz docs/USTALENIA.md punkt 7.
# Makefile przekazuje ja dalej jako --model-name, bo konfiguracja Pynguina ma
# niepusta wartosc domyslna "gpt-4o-mini", ktora wygrywa ze srodowiskiem.
LLM_MODEL="gpt-4o-mini"

# Endpoint. Puste = OpenAI. Tu dziala kazdy serwer zgodny z OpenAI
# (vLLM, Ollama, LiteLLM, Azure przez proxy).
LLM_BASE_URL=""
