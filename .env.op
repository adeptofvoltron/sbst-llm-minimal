# Configuration template for `make hybrid`. This file IS in the repository,
# because it holds no secret - only 1Password references.
#
# Run it without ever copying the key to disk:
#
#   op run --env-file=.env.op -- make hybrid MODULE=invoice
#
# Or locally: copy it to .env (which is in .gitignore) and fill in the values.
# .env never reaches git and is never printed to the screen.

# Key for an OpenAI-compatible API. Pynguin reads it from the ENVIRONMENT
# (pynguin/utils/openai_key_resolver.py: PYNGUIN_OPENAI_API_KEY,
# OPENAI_API_KEY, LLM_API_KEY) - never pass it via --api_key, because flags
# are visible in `ps` and in shell history.
OPENAI_API_KEY="op://Private/OpenAI/api_key"

# Model. NOTE: this variable alone is not enough - see docs/FINDINGS.md point 7.
# The Makefile forwards it as --model-name, because Pynguin's configuration has
# a non-empty default of "gpt-4o-mini" that beats the environment.
LLM_MODEL="gpt-4o-mini"

# Endpoint. Empty = OpenAI. Any OpenAI-compatible server works here
# (vLLM, Ollama, LiteLLM, Azure behind a proxy).
LLM_BASE_URL=""
